FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VIBE_TRADING_ENABLE_SHELL_TOOLS=0 \
    API_ALLOWED_HOSTS=vibe,localhost,127.0.0.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vibe.txt /tmp/requirements-vibe.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements-vibe.txt

EXPOSE 8900

CMD ["vibe-trading-mcp", "--transport", "http", "--host", "0.0.0.0", "--port", "8900"]
