# Public Bitget Reality market data. AlphaArena never sends order requests.
BITGET_BASE_URL=https://api.bitget.com
MARKET_CACHE_SECONDS=10

# Frontend origins (comma-separated in production)
FRONTEND_ORIGINS=http://localhost:5173

# Lightweight 24/7 watcher. Public metrics only; zero scheduled LLM calls.
WATCHER_ENABLED=true
WATCHER_INTERVAL_SECONDS=60

# Qwen model-family inference. Groq is the local default; Alibaba Cloud is the
# official hackathon-credit path (Base URL https://hackathon.bitgetops.com/v1,
# Model qwen3.6-plus). These are AlphaArena safety fuses, not provider quota/billing claims.
AI_PROVIDER=groq
QWEN_API_KEY=
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_MODEL=qwen/qwen3.8-27b
# Alibaba hackathon alternative:
# AI_PROVIDER=alibaba
# QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
# QWEN_MODEL=qwen3.6-plus
QWEN_DAILY_ATTEMPT_LIMIT=12
QWEN_MAX_OUTPUT_TOKENS=3000
QWEN_MAX_ATTEMPTS_PER_REQUEST=2
QWEN_RETRY_MAX_WAIT_SECONDS=10
QWEN_TIMEOUT_SECONDS=35

# Bitget Signal public MCP context
BITGET_SIGNAL_MCP_URL=https://datahub.noxiaohao.com/mcp
SIGNAL_CACHE_SECONDS=300

# Vibe-Trading research-only Streamable HTTP MCP sidecar
VIBE_MCP_URL=
VIBE_CACHE_SECONDS=900
MCP_TIMEOUT_SECONDS=20

# Optional continuous Decision Tape / Jev worker. The URL points to your
# own thin adapter around whatever Jev early-access SDK/API credentials you
# receive; AlphaArena expects only {direction, confidence, ...} back.
JEV_ADAPTER_URL=
JEV_ADAPTER_TOKEN=
JEV_ADAPTER_TIMEOUT_SECONDS=2
DECISION_TAPE_INTERVAL_SECONDS=5
DECISION_TAPE_SYMBOLS=rNVDA

# MongoDB Atlas persistence. Local/dev may leave this empty and use memory.
# Production should set REQUIRE_PERSISTENT_STORAGE=true so deployment fails
# rather than silently losing battles when a serverless instance recycles.
MONGODB_URI=
MONGODB_DB=alphaarena
REQUIRE_PERSISTENT_STORAGE=false

# Paper balance only. It is never withdrawable and never sent to Bitget.
ARENA_STARTING_CAPITAL=100000
