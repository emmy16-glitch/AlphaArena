# Public Bitget Reality market data. AlphaArena never sends order requests.
BITGET_BASE_URL=https://api.bitget.com
MARKET_CACHE_SECONDS=10

# Frontend origins (comma-separated in production)
FRONTEND_ORIGINS=http://localhost:5173

# Lightweight 24/7 watcher. Public metrics only; zero scheduled LLM calls.
WATCHER_ENABLED=true
WATCHER_INTERVAL_SECONDS=60

# Qwen / Alibaba Cloud Model Studio. These are AlphaArena safety fuses, not
# provider quota/billing claims. Keep conservative defaults for a free build.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_DAILY_ATTEMPT_LIMIT=12
QWEN_MAX_OUTPUT_TOKENS=1400
QWEN_MAX_ATTEMPTS_PER_REQUEST=1
QWEN_TIMEOUT_SECONDS=35

# Bitget Signal public MCP context
BITGET_SIGNAL_MCP_URL=https://datahub.noxiaohao.com/mcp
SIGNAL_CACHE_SECONDS=300

# Vibe-Trading research-only Streamable HTTP MCP sidecar
VIBE_MCP_URL=
VIBE_CACHE_SECONDS=900
MCP_TIMEOUT_SECONDS=20

# Optional MongoDB Atlas persistence. Empty = in-memory fallback.
MONGODB_URI=
MONGODB_DB=alphaarena

# Paper balance only. It is never withdrawable and never sent to Bitget.
ARENA_STARTING_CAPITAL=100000
