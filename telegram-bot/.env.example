# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Telegram token from @BotFather.
BOT_TOKEN=
# OpenCode server (verified routes for v1.18.30: /global/health, /session, /session/{id}/message).
OPENCODE_URL=http://localhost:4096
OPENCODE_DIRECTORY=/home/azureuser/projects/AlphaArena
# Optional: comma-separated Telegram chat ids allowed to use the bot. Empty = allow all.
ALLOWED_CHAT_IDS=
